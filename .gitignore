# pyenv
#   For a library or package, you might want to ignore these files since the Python version is
#   checked into your system or configured via poetry, pipenv etc.
# .python-version

# pipenv
#   According to pypa/pipenv#118, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if platforms vary, locking can be source of friction.
#Pipfile.lock

# poetry
#   Poetry uses poetry.lock to ensure reproducible builds. It's recommended to commit this file.
#   https://python-poetry.org
#poetry.lock

# pdm
#   PDM stores project-wide configurations in .pdm-python
.pdm-python
